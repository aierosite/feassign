    var costs: [i64; 1024] = [0; 1024]
    var ordinal: usize = 0
    while ordinal < 729 {
        var digits = ordinal
        var cell: usize = 0
        while cell < 6 {
            costs[cell] = alphabet[digits % 3]
            digits /= 3
            cell += 1
        }
        oracle_check(2, 3, ref costs, expected[ordinal], ordinal)
        ordinal += 1
    }
}

#[test]
fn oracle_separable_shapes_columns_1_4() {
    let expected: [i128; 10] = [
        -218, -218, -406, -218, -406, -564, -218, -409,
        -584, -729,
    ]
    var costs: [i64; 1024] = [0; 1024]
    var ordinal: usize = 0
    var columns: u8 = 1
    while columns <= 4 {
        var rows: u8 = 1
        while rows <= columns {
            var i: usize = 0
            while i < (rows as usize) {
                let row_index: i64 = i.downcast().unwrap()
                var j: usize = 0
                while j < (columns as usize) {
                    let column_offset: i64 = ((j * 17) % 37).downcast().unwrap()
                    costs[i * (columns as usize) + j] = row_index * 13 - 200 + column_offset - 18
                    j += 1
                }
                i += 1
            }
            oracle_check(rows, columns, ref costs, expected[ordinal], ordinal)
            ordinal += 1
            rows += 1
        }
        columns += 1
    }
    assert!(ordinal == 10)
}

