use core::Result

pub enum ModelError {
    Dimensions,
    CostCount,
    AssignmentCount,
    RowPotentialCount,
    ColumnPotentialCount,
    Index,
}

fn valid_dimensions(_ rows: u8, _ columns: u8) -> bool {
    rows > 0 && rows <= columns && columns <= 32
}

/// Complete row-major matrix; four two's-complement i64 lanes per owned word.
pub struct Problem {
    rows: u8,
    columns: u8,
    packed_costs: [u256; 256],
}

/// Copy a bounded input buffer into owned packed storage after shape checks.
/// Retain no reference to the supplied buffer and ignore unused capacity.
pub fn new_problem(
    _ rows: u8,
    _ columns: u8,
    _ cost_count: u16,
    _ costs: ref [i64; 1024],
) -> Result<ModelError, Problem> {
    if !valid_dimensions(rows, columns) {
        return Result::Err(ModelError::Dimensions)
    }
    let expected = (rows as usize) * (columns as usize)
    if (cost_count as usize) != expected {
        return Result::Err(ModelError::CostCount)
    }
    var packed_costs: [u256; 256] = [0; 256]
    var index: usize = 0
    while index < expected {
        let signed = costs[index] as i256
        let encoded = if signed < 0 { signed + 18446744073709551616 } else { signed }
        let lane: u256 = encoded.downcast().unwrap()
        let word = index / 4
        let shift = ((index % 4) * 64) as u256
        packed_costs[word] = packed_costs[word] | (lane << shift)
        index += 1
    }
    Result::Ok(Problem { rows, columns, packed_costs })
}

// Callers prove index < rows*columns <=1024 before entering this private helper.
fn read_cost(_ problem: ref Problem, _ index: usize) -> i64 {
    let shift = ((index % 4) * 64) as u256
    let lane = (problem.packed_costs[index / 4] >> shift) & 18446744073709551615
    let unsigned: i256 = lane.downcast().unwrap()
    let signed = if unsigned >= 9223372036854775808 {
        unsigned - 18446744073709551616
    } else { unsigned }
    signed.downcast().unwrap()
}

pub fn rows(_ problem: ref Problem) -> u8 { problem.rows }

pub fn columns(_ problem: ref Problem) -> u8 { problem.columns }

pub fn cost(
    _ problem: ref Problem,
    _ row: u8,
    _ column: u8,
) -> Result<ModelError, i64> {
    if !valid_dimensions(problem.rows, problem.columns) {
        return Result::Err(ModelError::Dimensions)
    }
    if row >= problem.rows || column >= problem.columns {
        return Result::Err(ModelError::Index)
    }
    let index = (row as usize) * (problem.columns as usize) + (column as usize)
    Result::Ok(read_cost(problem, index))
}

/// Shape-valid, mathematically untrusted certificate. No ABI/deserializer bypass.
pub struct Certificate {
    rows: u8,
    columns: u8,
    selected: [u8; 32],
    row_potentials: [i128; 32],
    column_potentials: [i128; 32],
}

/// Validate semantic lengths, not injectivity or dual feasibility.
/// Every selected byte and every i128 potential remains untrusted proof input.
pub fn new_certificate(
    _ problem: ref Problem,
    _ selected_count: u8,
    _ row_potential_count: u8,
    _ column_potential_count: u8,
    _ selected: own [u8; 32],
    _ row_potentials: own [i128; 32],
    _ column_potentials: own [i128; 32],
) -> Result<ModelError, Certificate> {
    if !valid_dimensions(problem.rows, problem.columns) {
        return Result::Err(ModelError::Dimensions)
    }
    if selected_count != problem.rows {
        return Result::Err(ModelError::AssignmentCount)
    }
    if row_potential_count != problem.rows {
        return Result::Err(ModelError::RowPotentialCount)
    }
    if column_potential_count != problem.columns {
        return Result::Err(ModelError::ColumnPotentialCount)
    }
    Result::Ok(Certificate {
        rows: problem.rows,
        columns: problem.columns,
        selected,
        row_potentials,
        column_potentials,
    })
}

pub fn certificate_shape(_ certificate: ref Certificate) -> (u8, u8) {
    (certificate.rows, certificate.columns)
}

pub fn selected_column(
    _ certificate: ref Certificate,
    _ row: u8,
) -> Result<ModelError, u8> {
    if !valid_dimensions(certificate.rows, certificate.columns) {
        return Result::Err(ModelError::Dimensions)
    }
    if row >= certificate.rows { return Result::Err(ModelError::Index) }
    Result::Ok(certificate.selected[row as usize])
}

pub fn row_potential(
    _ certificate: ref Certificate,
    _ row: u8,
) -> Result<ModelError, i128> {
    if !valid_dimensions(certificate.rows, certificate.columns) {
        return Result::Err(ModelError::Dimensions)
    }
    if row >= certificate.rows { return Result::Err(ModelError::Index) }
    Result::Ok(certificate.row_potentials[row as usize])
}

pub fn column_potential(
    _ certificate: ref Certificate,
    _ column: u8,
) -> Result<ModelError, i128> {
    if !valid_dimensions(certificate.rows, certificate.columns) {
        return Result::Err(ModelError::Dimensions)
    }
    if column >= certificate.columns { return Result::Err(ModelError::Index) }
    Result::Ok(certificate.column_potentials[column as usize])
}

pub enum VerifyError {
    Shape,
    ColumnIndex,
    DuplicateColumn,
    PositiveColumnPotential,
    DualInfeasible,
    SelectedEdgeNotTight,
    NonzeroUnusedColumn,
}

/// Verify a rectangular minimum-cost assignment without running an optimizer.
/// For any other injection, feasibility and v<=0 give the full-dual lower bound.
/// Tight chosen edges and zero unused v attain it. All combined math widens first.
pub fn verify(
    _ problem: ref Problem,
    _ certificate: ref Certificate,
) -> Result<VerifyError, i128> {
    if !valid_dimensions(problem.rows, problem.columns)
        || !valid_dimensions(certificate.rows, certificate.columns)
        || certificate.rows != problem.rows || certificate.columns != problem.columns {
        return Result::Err(VerifyError::Shape)
    }
    let row_count = problem.rows as usize
    let column_count = problem.columns as usize
    var seen: [bool; 32] = [false; 32]

    var row: usize = 0
    while row < row_count {
        let column = certificate.selected[row] as usize
        if column >= column_count { return Result::Err(VerifyError::ColumnIndex) }
        if seen[column] { return Result::Err(VerifyError::DuplicateColumn) }
        seen[column] = true
        row += 1
    }

    var column: usize = 0
    while column < column_count {
        if certificate.column_potentials[column] > 0 {
            return Result::Err(VerifyError::PositiveColumnPotential)
        }
        column += 1
    }

    var total: i256 = 0
    row = 0
    while row < row_count {
        let u = certificate.row_potentials[row] as i256
        let base = row * column_count
        column = 0
        while column < column_count {
            let v = certificate.column_potentials[column] as i256
            let edge_cost = read_cost(problem, base + column) as i256
            if u + v > edge_cost { return Result::Err(VerifyError::DualInfeasible) }
            column += 1
        }
        let selected = certificate.selected[row] as usize
        let selected_cost = read_cost(problem, base + selected) as i256
        let selected_v = certificate.column_potentials[selected] as i256
        if u + selected_v != selected_cost {
            return Result::Err(VerifyError::SelectedEdgeNotTight)
        }
        total += selected_cost
        row += 1
    }

    column = 0
    while column < column_count {
        if !seen[column] && certificate.column_potentials[column] != 0 {
            return Result::Err(VerifyError::NonzeroUnusedColumn)
        }
        column += 1
    }
    // At most32 i64 costs fit i128. Failure here is an implementation invariant
    // failure, never an unsupported-input escape for a valid complete problem.
    let checked_total: i128 = total.downcast().unwrap()
    Result::Ok(checked_total)
}

pub enum SolveError {
    Shape,
    InternalInvariant,
}

/// Rectangular Hungarian primal-dual optimizer. The verifier has no dependency
/// on this search. All33-slot workspace is local; public indices stay zero-based.
pub fn solve(_ problem: ref Problem) -> Result<SolveError, Certificate> {
    if !valid_dimensions(problem.rows, problem.columns) {
        return Result::Err(SolveError::Shape)
    }
    let r = problem.rows as usize
    let c = problem.columns as usize
    var u: [i256; 33] = [0; 33]
    var v: [i256; 33] = [0; 33]
    var owner: [usize; 33] = [0; 33]
    var predecessor: [usize; 33] = [0; 33]
    var slack: [i256; 33] = [0; 33]
    var has_slack: [bool; 33] = [false; 33]
    var reached: [bool; 33] = [false; 33]

    // Initialize every row, including future rows, to keep all pairs feasible.
    var row: usize = 1
    while row <= r {
        let base = (row - 1) * c
        var minimum = read_cost(problem, base) as i256
        var column: usize = 1
        while column < c {
            let value = read_cost(problem, base + column) as i256
            if value < minimum { minimum = value }
            column += 1
        }
        u[row] = minimum
        row += 1
    }

    row = 1
    while row <= r {
        owner[0] = row // Dummy column points to the new, unmatched row.
        var column: usize = 0
        while column <= c {
            reached[column] = false
            has_slack[column] = false
            predecessor[column] = 0
            column += 1
        }
        var current: usize = 0
        var searching = true
        var scans: usize = 0
        while searching {
            scans += 1
            if scans > row || reached[current] {
                return Result::Err(SolveError::InternalInvariant)
            }
            reached[current] = true
            let active_row = owner[current]
            if active_row == 0 || active_row > r {
                return Result::Err(SolveError::InternalInvariant)
            }
            var next: usize = 0
            var delta: i256 = 0
            var found = false
            column = 1
            while column <= c {
                if !reached[column] {
                    let edge = read_cost(problem, (active_row - 1) * c + column - 1) as i256
                    let reduced = edge - u[active_row] - v[column]
                    if reduced < 0 { return Result::Err(SolveError::InternalInvariant) }
                    if !has_slack[column] || reduced < slack[column] {
                        slack[column] = reduced
                        has_slack[column] = true
                        predecessor[column] = current
                    }
                    if !found || slack[column] < delta {
                        delta = slack[column]
                        next = column
                        found = true
                    }
                }
                column += 1
            }
            if !found || delta < 0 { return Result::Err(SolveError::InternalInvariant) }
            column = 0
            while column <= c {
                if reached[column] {
                    let matched_row = owner[column]
                    if matched_row == 0 || matched_row > r {
                        return Result::Err(SolveError::InternalInvariant)
                    }
                    u[matched_row] += delta
                    v[column] -= delta
                } else if has_slack[column] {
                    slack[column] -= delta
                }
                column += 1
            }
            current = next
            // A free column stops the search before it enters the update set.
            searching = owner[current] != 0
        }
        var steps: usize = 0
        while current != 0 {
            steps += 1
            let previous = predecessor[current]
            if steps > row || previous > c || owner[previous] == 0 {
                return Result::Err(SolveError::InternalInvariant)
            }
            owner[current] = owner[previous]
            current = previous
        }
        row += 1
    }

    var selected: [u8; 32] = [0; 32]
    var public_u: [i128; 32] = [0; 32]
    var public_v: [i128; 32] = [0; 32]
    row = 1
    while row <= r {
        let narrowed: core::Option<i128> = u[row].downcast()
        match narrowed {
            core::Option::Some(value) => public_u[row - 1] = value,
            core::Option::None => return Result::Err(SolveError::InternalInvariant),
        }
        row += 1
    }
    var column: usize = 1
    while column <= c {
        let narrowed: core::Option<i128> = v[column].downcast()
        match narrowed {
            core::Option::Some(value) => public_v[column - 1] = value,
            core::Option::None => return Result::Err(SolveError::InternalInvariant),
        }
        if owner[column] != 0 {
            let public_column: u8 = (column - 1).downcast().unwrap()
            selected[owner[column] - 1] = public_column
        }
        column += 1
    }
    let certificate = Certificate {
        rows: problem.rows,
        columns: problem.columns,
        selected,
        row_potentials: public_u,
        column_potentials: public_v,
    }
    // Cost is recomputed by verify; -v[dummy] omits row-min initialization.
    match verify(problem, ref certificate) {
        Result::Ok(_) => Result::Ok(certificate),
        Result::Err(_) => Result::Err(SolveError::InternalInvariant),
    }
}

#[test]
fn solve_defensively_rejects_internal_malformed_shape() {
    // An external consumer cannot create these private fields. The solver
    // nevertheless rejects bad metadata before touching its workspace/matrix.
    var problem = Problem { rows: 0, columns: 32, packed_costs: [0; 256] }
    match solve(ref problem) {
        Result::Err(SolveError::Shape) => (),
        _ => core::panic(),
    }
    problem.rows = 1
    problem.columns = 33
    match solve(ref problem) {
        Result::Err(SolveError::Shape) => (),
        _ => core::panic(),
    }
}

fn checked_cost(_ problem: ref Problem, _ row: u8, _ column: u8) -> i64 {
    match cost(problem, row, column) {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}

/// Early representation gate, not a solver or certificate test.
#[test]
fn full32_owned_storage_shared_reads_and_signed_endpoints() {
    var values: [i64; 1024] = [0; 1024]
    var index: usize = 0
    while index < 1024 {
        let signed_index: i64 = index.downcast().unwrap()
        values[index] = signed_index - 512
        index += 1
    }
    values[0] = i64::min()
    values[1023] = i64::max()

    let problem = match new_problem(32, 32, 1024, ref values) {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
    assert!(rows(ref problem) == 32)
    assert!(columns(ref problem) == 32)
    assert!(checked_cost(ref problem, 0, 0) == i64::min())
    assert!(checked_cost(ref problem, 8, 0) == -256)
    assert!(checked_cost(ref problem, 31, 30) == 510)
    assert!(checked_cost(ref problem, 31, 31) == i64::max())

    var total: i256 = 0
    var row: u8 = 0
    while row < 32 {
        var column: u8 = 0
        while column < 32 {
            let offset = (row as usize) * 32 + (column as usize)
            let actual = checked_cost(ref problem, row, column)
            let expected: i64 = if offset == 0 { i64::min() }
                else if offset == 1023 { i64::max() }
                else {
                    let value: i64 = offset.downcast().unwrap()
                    value - 512
                }
            assert!(actual == expected)
            total += actual as i256
            column += 1
        }
        row += 1
    }
    // Sum(k-512), k=0..1023, is -512. Replacing the endpoints preserves it:
    // (-512)+511 == i64::min()+i64::max() == -1, in the wider type.
    assert!(total == -512)
}

#[test]
fn constructed_problem_owns_its_data_after_input_changes() {
    var values: [i64; 1024] = [0; 1024]
    values[0] = -7
    values[1] = 11
    let problem = match new_problem(1, 2, 2, ref values) {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
    values[0] = 99
    values[1] = -123
    assert!(checked_cost(ref problem, 0, 0) == -7)
    assert!(checked_cost(ref problem, 0, 1) == 11)
}

#[test]
fn invalid_problem_dimensions_reject_before_count_or_access() {
    let values: [i64; 1024] = [0; 1024]
    let bad_rows: [u8; 8] = [0, 0, 1, 2, 1, 33, 32, 255]
    let bad_columns: [u8; 8] = [0, 1, 0, 1, 33, 33, 33, 255]
    var index: usize = 0
    while index < 8 {
        match new_problem(bad_rows[index], bad_columns[index], 0, ref values) {
            Result::Err(ModelError::Dimensions) => (),
            _ => core::panic(),
        }
        index += 1
    }
}

#[test]
fn exact_cost_count_is_not_capacity_or_truncation() {
    let values: [i64; 1024] = [0; 1024]
    let bad_counts: [u16; 5] = [0, 31, 33, 1024, 65535]
    var index: usize = 0
    while index < 5 {
        match new_problem(1, 32, bad_counts[index], ref values) {
            Result::Err(ModelError::CostCount) => (),
            _ => core::panic(),
        }
        index += 1
    }
    match new_problem(32, 32, 1023, ref values) {
        Result::Err(ModelError::CostCount) => (),
        _ => core::panic(),
    }
    match new_problem(32, 32, 1025, ref values) {
        Result::Err(ModelError::CostCount) => (),
        _ => core::panic(),
    }
}

fn one_by_two_problem() -> Problem {
    var values: [i64; 1024] = [0; 1024]
    values[0] = i64::min()
    values[1] = i64::max()
    values[2] = 123 // Unused physical capacity must not become a third column.
    match new_problem(1, 2, 2, ref values) {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}

#[test]
fn one_row_surplus_columns_and_checked_access() {
    let problem = one_by_two_problem()
    assert!(rows(ref problem) == 1)
    assert!(columns(ref problem) == 2)
    assert!(checked_cost(ref problem, 0, 0) == i64::min())
    assert!(checked_cost(ref problem, 0, 1) == i64::max())
    match cost(ref problem, 0, 2) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
    match cost(ref problem, 1, 0) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
    match cost(ref problem, 255, 255) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
}

#[test]
fn certificate_lengths_are_exact_and_independent() {
    let problem = one_by_two_problem()
    match new_certificate(ref problem, 0, 1, 2, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::AssignmentCount) => (),
        _ => core::panic(),
    }
    match new_certificate(ref problem, 1, 2, 2, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::RowPotentialCount) => (),
        _ => core::panic(),
    }
    match new_certificate(ref problem, 1, 1, 1, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::ColumnPotentialCount) => (),
        _ => core::panic(),
    }
    match new_certificate(ref problem, 255, 1, 2, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::AssignmentCount) => (),
        _ => core::panic(),
    }
    match new_certificate(ref problem, 1, 255, 2, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::RowPotentialCount) => (),
        _ => core::panic(),
    }
    match new_certificate(ref problem, 1, 1, 255, [0; 32], [0; 32], [0; 32]) {
        Result::Err(ModelError::ColumnPotentialCount) => (),
        _ => core::panic(),
    }
}

#[test]
fn certificate_preserves_untrusted_full_width_values_and_limits_reads() {
    let problem = one_by_two_problem()
    var selected: [u8; 32] = [0; 32]
    var u: [i128; 32] = [0; 32]
    var v: [i128; 32] = [0; 32]
    selected[0] = 255 // Shape is valid; mathematical verification must reject it.
    u[0] = i128::min()
    v[0] = i128::max()
    v[1] = i128::min()
    let certificate = match new_certificate(ref problem, 1, 1, 2, selected, u, v) {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
    let (r, c) = certificate_shape(ref certificate)
    assert!(r == 1 && c == 2)
    match selected_column(ref certificate, 0) {
        Result::Ok(value) => assert!(value == 255),
        _ => core::panic(),
    }
    match row_potential(ref certificate, 0) {
        Result::Ok(value) => assert!(value == i128::min()),
        _ => core::panic(),
    }
    match column_potential(ref certificate, 0) {
        Result::Ok(value) => assert!(value == i128::max()),
        _ => core::panic(),
    }
    match column_potential(ref certificate, 1) {
        Result::Ok(value) => assert!(value == i128::min()),
        _ => core::panic(),
    }
    match selected_column(ref certificate, 1) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
    match row_potential(ref certificate, 255) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
    match column_potential(ref certificate, 2) {
        Result::Err(ModelError::Index) => (),
        _ => core::panic(),
    }
}
