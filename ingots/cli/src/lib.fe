use core::{AsBytes, Result}
use std::native::Args
use assignment::{
    Problem, Certificate, ModelError, new_problem, new_certificate, rows, columns, cost,
    selected_column, row_potential, column_potential, solve, verify,
}

// Scalar C ABI only. The C bridge owns stdio and signal-layout details.
extern {
    fn fa_io_init() -> i32
    fn fa_read_char() -> i32
    fn fa_write_char(_ byte: i32, _ stream: i32) -> i32
    fn fa_io_finish() -> i32
}

struct Input {
    current: i32,
    count: usize,
    failure: i32,
}

fn whitespace(_ byte: i32) -> bool {
    byte == 32 || (byte >= 9 && byte <= 13)
}

impl Input {
    fn advance(mut self) {
        if self.failure != 0 { return }
        let byte = fa_read_char()
        if byte == -2 {
            self.failure = 5
            self.current = -1
        } else if byte >= 0 {
            if self.count == 131072 {
                self.failure = 3
                self.current = -1
            } else {
                self.count += 1
                self.current = byte
            }
        } else {
            self.current = -1
        }
    }

    fn skip_space(mut self) {
        while self.failure == 0 && whitespace(self.current) { self.advance() }
    }

    fn literal<T: AsBytes>(mut self, _ text: T) {
        self.skip_space()
        let bytes = text.as_bytes()
        var i: usize = 0
        while i < T::N && self.failure == 0 {
            if self.current != bytes[i] as i32 { self.failure = 2 }
            else { self.advance() }
            i += 1
        }
        if self.failure == 0 && self.current != -1 && !whitespace(self.current) {
            self.failure = 2
        }
    }

    // Accumulate a nonnegative magnitude, guarding before multiply/add.
    fn number(mut self, _ signed: bool, _ positive: i256, _ negative: i256) -> i256 {
        self.skip_space()
        var minus = false
        if signed && self.current == 45 {
            minus = true
            self.advance()
        }
        let limit = if minus { negative } else { positive }
        var value: i256 = 0
        var digits: usize = 0
        while self.failure == 0 && self.current >= 48 && self.current <= 57 {
            let digit = (self.current - 48) as i256
            if value > (limit - digit) / 10 {
                self.failure = 2
            } else {
                value = value * 10 + digit
                digits += 1
                self.advance()
            }
        }
        if self.failure == 0 && (digits == 0 || (self.current != -1 && !whitespace(self.current))) {
            self.failure = 2
        }
        if minus { -value } else { value }
    }

    fn end(mut self) {
        self.skip_space()
        if self.failure == 0 && self.current != -1 { self.failure = 2 }
    }
}

fn emit<T: AsBytes>(_ text: T, _ stream: i32) {
    let bytes = text.as_bytes()
    var i: usize = 0
    while i < T::N {
        let _ = fa_write_char(bytes[i] as i32, stream)
        i += 1
    }
}

fn decimal(_ value: i128, _ stream: i32) {
    let wide = value as i256
    var magnitude = if wide < 0 { -wide } else { wide }
    var digits: [u8; 40] = [0; 40]
    var length: usize = 0
    while magnitude > 0 {
        digits[length] = ((magnitude % 10) + 48).downcast().unwrap()
        length += 1
        magnitude /= 10
    }
    if wide < 0 { emit("-", stream) }
    if length == 0 { emit("0", stream) }
    while length > 0 {
        length -= 1
        let _ = fa_write_char(digits[length] as i32, stream)
    }
}

// Only used after validated dimensions and a successful shared verification.
fn model_value<T>(_ result: own Result<ModelError, T>) -> T {
    match result {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}

fn output(_ problem: ref Problem, _ certificate: ref Certificate, _ total: i128) {
    emit("FEASSIGN 1\n", 0)
    decimal(rows(problem) as i128, 0)
    emit(" ", 0)
    decimal(columns(problem) as i128, 0)
    emit("\n", 0)
    var row: u8 = 0
    while row < rows(problem) {
        var column: u8 = 0
        while column < columns(problem) {
            if column > 0 { emit(" ", 0) }
            decimal(model_value(cost(problem, row, column)) as i128, 0)
            column += 1
        }
        emit("\n", 0)
        row += 1
    }
    row = 0
    while row < rows(problem) {
        if row > 0 { emit(" ", 0) }
        decimal(model_value(selected_column(certificate, row)) as i128, 0)
        row += 1
    }
    emit("\n", 0)
    row = 0
    while row < rows(problem) {
        if row > 0 { emit(" ", 0) }
        decimal(model_value(row_potential(certificate, row)), 0)
        row += 1
    }
    emit("\n", 0)
    var column: u8 = 0
    while column < columns(problem) {
        if column > 0 { emit(" ", 0) }
        decimal(model_value(column_potential(certificate, column)), 0)
        column += 1
    }
    emit("\nTOTAL ", 0)
    decimal(total, 0)
    emit("\n", 0)
}

fn run(_ checking: bool) -> i32 {
    var input = Input { current: -1, count: 0, failure: 0 }
    input.advance()
    if checking {
        input.literal("FEASSIGN")
        input.literal("1")
    }
    let r_value = input.number(false, 32, 0)
    let c_value = input.number(false, 32, 0)
    if input.failure != 0 { return input.failure }
    if r_value < 1 || c_value < r_value { return 2 }
    let r: u8 = r_value.downcast().unwrap()
    let c: u8 = c_value.downcast().unwrap()
    let count = (r as usize) * (c as usize)
    var costs: [i64; 1024] = [0; 1024]
    var index: usize = 0
    while index < count {
        let value = input.number(true, 9223372036854775807, 9223372036854775808)
        if input.failure != 0 { return input.failure }
        costs[index] = value.downcast().unwrap()
        index += 1
    }
    let problem = match new_problem(r, c, count.downcast().unwrap(), ref costs) {
        Result::Ok(value) => value,
        Result::Err(_) => return 6,
    }
    let certificate = if checking {
        var selected: [u8; 32] = [0; 32]
        var u: [i128; 32] = [0; 32]
        var v: [i128; 32] = [0; 32]
        index = 0
        while index < r as usize {
            let value = input.number(false, 255, 0)
            if input.failure != 0 { return input.failure }
            selected[index] = value.downcast().unwrap()
            index += 1
        }
        index = 0
        while index < r as usize {
            let value = input.number(true, 170141183460469231731687303715884105727, 170141183460469231731687303715884105728)
            if input.failure != 0 { return input.failure }
            u[index] = value.downcast().unwrap()
            index += 1
        }
        index = 0
        while index < c as usize {
            let value = input.number(true, 170141183460469231731687303715884105727, 170141183460469231731687303715884105728)
            if input.failure != 0 { return input.failure }
            v[index] = value.downcast().unwrap()
            index += 1
        }
        input.literal("TOTAL")
        let claimed = input.number(true, 170141183460469231731687303715884105727, 170141183460469231731687303715884105728)
        input.end()
        if input.failure != 0 { return input.failure }
        let certificate = match new_certificate(ref problem, r, r, c, selected, u, v) {
            Result::Ok(value) => value,
            Result::Err(_) => return 6,
        }
        let actual = match verify(ref problem, ref certificate) {
            Result::Ok(value) => value,
            Result::Err(_) => return 4,
        }
        if actual as i256 != claimed { return 4 }
        certificate
    } else {
        input.end()
        if input.failure != 0 { return input.failure }
        match solve(ref problem) {
            Result::Ok(value) => value,
            Result::Err(_) => return 6,
        }
    }
    let total = match verify(ref problem, ref certificate) {
        Result::Ok(value) => value,
        Result::Err(_) => return 6,
    }
    if checking {
        emit("VALID ", 0)
        decimal(total, 0)
        emit("\n", 0)
    } else { output(ref problem, ref certificate, total) }
    0
}

fn argument<T: AsBytes>(_ args: Args, _ text: T) -> bool {
    let arg = args.get(1)
    if arg.len() != T::N { return false }
    let bytes = text.as_bytes()
    var index: usize = 0
    while index < T::N {
        if arg.byte_at(index) != bytes[index] { return false }
        index += 1
    }
    true
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    if fa_io_init() != 0 { return 5 }
    // The official native entry supplies live argc/argv for this entire call.
    let args = unsafe { Args::new(argc, argv) }
    let status = if args.len() != 2 { 64 }
    else if argument(args, "solve") { run(false) }
    else if argument(args, "verify") { run(true) }
    else if argument(args, "--help") {
        emit("Usage: feassign solve | verify\n", 0)
        emit("See docs/CLI.md for the ", 0)
        emit("versioned text format.\n", 0)
        0
    } else { 64 }
    if status != 0 {
        emit("feassign: ", 1)
        if status == 2 { emit("invalid input\n", 1) }
        else if status == 3 { emit("input exceeds 131072 bytes\n", 1) }
        else if status == 4 { emit("invalid certificate\n", 1) }
        else if status == 5 { emit("input/output failure\n", 1) }
        else if status == 6 { emit("internal invariant failure\n", 1) }
        else {
            emit("expected solve, verify ", 1)
            emit("or --help\n", 1)
        }
    }
    if fa_io_finish() != 0 { return 5 }
    status
}
